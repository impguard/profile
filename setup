#!/usr/bin/env bash
set -euo pipefail
shopt -s nullglob dotglob

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
PROFILE_DIR=$ROOT/profile
BACKUP_DIR=
WORK_DIR=
COPIED_COUNT=0
UNCHANGED_COUNT=0
BACKUP_COUNT=0

show_profile() {
  local directory=$1 file phase label separator
  printf 'Profile      : %s\n' "${directory##*/}"
  case ${directory##*/} in
    Common)       printf 'For          : Ubuntu, WSL, macOS - shared Bash, Git, and Neovim configuration\n' ;;
    Ubuntu)       printf 'For          : Ubuntu (native or WSL) - base tools\n' ;;
    macOS)        printf 'For          : macOS - base tools and Bash login configuration\n' ;;
    WSL)          printf 'For          : Ubuntu on WSL - Windows integration; combine with Ubuntu Common\n' ;;
    Terminal)     printf 'For          : Ubuntu, WSL, macOS - optional terminal tools\n' ;;
    WSLClipboard) printf 'For          : x86_64 Ubuntu on WSL - optional clipboard sharing\n' ;;
    Hammerspoon)  printf 'For          : macOS only - optional Hammerspoon window shortcuts\n' ;;
  esac
  if [[ -d $directory/home ]]; then
    printf 'Home files   : '
    separator=
    while IFS= read -r -d '' file; do
      printf '%s%s' "$separator" "${file#"$directory/home/"}"
      separator=', '
    done < <(find "$directory/home" -type f -print0)
    printf '\n'
  fi
  for phase in pre init post; do
    separator=
    case $phase in pre) label='Pre scripts' ;; init) label='Init scripts' ;; post) label='Post scripts' ;; esac
    for file in "$directory/$phase"/*.sh; do
      if [[ -z $separator ]]; then printf '%-13s: ' "$label"; fi
      printf '%s%s' "$separator" "${file##*/}"
      separator=', '
    done
    if [[ -n $separator ]]; then printf '\n'; fi
  done
  printf '\n'
}

show_profiles() {
  local directory
  for directory in "$PROFILE_DIR"/*; do
    [[ -d $directory && ${directory##*/} != Windows ]] || continue
    show_profile "$directory"
  done
  printf 'Windows profiles: use ./setup.ps1\n'
}

usage() {
  show_profiles
  cat <<'EOF'

Usage:
  ./setup install PROFILE...         Install tools and home configuration
  ./setup home PROFILE...            Copy home configuration only
  ./setup (pre|init|post) PROFILE...  Run scripts for one phase only
  ./setup plan PROFILE...            Preview profiles and destinations
  ./setup script SCRIPT_PATH         Run one installation script
  ./setup ls                         List profiles and scripts (also: list)
  ./setup info                       Show system information
  ./setup --help                     Show this summary (also the default)

Base setup:
  Ubuntu: ./setup install Ubuntu Common
  WSL:    ./setup install WSL Ubuntu Common
  macOS:  ./setup install macOS Common
EOF
}

fail() { printf '%s\n' "$*" >&2; exit 1; }

backup() {
  local target=$1 relative=$2
  if [[ -e $target || -L $target ]]; then
    if [[ -z $BACKUP_DIR ]]; then
      mkdir -p "$HOME/.profile-backups"
      BACKUP_DIR=$(mktemp -d "$HOME/.profile-backups/$(date +%Y%m%d-%H%M%S).XXXXXX")
      printf 'Backups: %s\n' "$BACKUP_DIR"
    fi
    mkdir -p "$(dirname "$BACKUP_DIR/$relative")"
    if [[ -L $target && -e $target ]]; then
      # Snapshot the contents; a backed-up link alone can change with the repo.
      cp -RLp -- "$target" "$BACKUP_DIR/$relative"
      rm -- "$target"
    else
      mv -- "$target" "$BACKUP_DIR/$relative"
    fi
    BACKUP_COUNT=$((BACKUP_COUNT + 1))
    printf 'Backed up: %s -> %s\n' "$target" "$BACKUP_DIR/$relative"
  fi
}

# Replace directory symlinks too, so writes never flow back into a checkout.
ensure_directory() {
  local relative=$1 preserved=
  [[ $relative != . ]] || return 0
  ensure_directory "$(dirname "$relative")"
  if [[ -L $HOME/$relative && -d $HOME/$relative ]]; then
    preserved=$(mktemp -d "$WORK_DIR/preserved.XXXXXX")
    cp -RLp "$HOME/$relative/." "$preserved/"
  fi
  if [[ -L $HOME/$relative || ( -e $HOME/$relative && ! -d $HOME/$relative ) ]]; then
    # Use a separate path so subsequent per-file backups cannot overwrite it.
    backup "$HOME/$relative" "directory-links/$relative"
  fi
  mkdir -p "$HOME/$relative"
  if [[ -n $preserved ]]; then cp -Rp "$preserved/." "$HOME/$relative/"; fi
}

copy_file() {
  local source=$1 relative=$2 target=$HOME/$2
  ensure_directory "$(dirname "$relative")"
  if [[ ! -L $target && -f $target ]] && cmp -s "$source" "$target"; then
    UNCHANGED_COUNT=$((UNCHANGED_COUNT + 1))
    printf 'Skipped (unchanged): %s\n' "$target"
    return 0
  fi
  backup "$target" "$relative"
  cp -p -- "$source" "$target"
  COPIED_COUNT=$((COPIED_COUNT + 1))
  printf 'Copied: %s\n' "$target"
}

install_git_config() {
  local source=$1 defaults='~/.config/git/profile.gitconfig' temporary
  copy_file "$source" .config/git/profile.gitconfig
  # Defaults come first; identity and personal settings stay in their original
  # location and take precedence. Detach links created by the old installer.
  if [[ ! -L $HOME/.gitconfig && -f $HOME/.gitconfig ]] &&
      git config --file "$HOME/.gitconfig" --get-all include.path | grep -Fxq "$defaults"; then
    UNCHANGED_COUNT=$((UNCHANGED_COUNT + 1))
    printf 'Skipped (defaults already included): %s\n' "$HOME/.gitconfig"
    return 0
  fi
  temporary=$WORK_DIR/gitconfig
  printf '[include]\n    path = %s\n' "$defaults" > "$temporary"
  chmod 600 "$temporary"
  if [[ -f $HOME/.gitconfig ]]; then
    cat "$HOME/.gitconfig" >> "$temporary"
  elif [[ -e $HOME/.gitconfig && ! -L $HOME/.gitconfig ]]; then
    fail "$HOME/.gitconfig must be a file"
  fi
  copy_file "$temporary" .gitconfig
}

copy_tree() {
  local source=$1 relative=${2:-} item name
  for item in "$source"/*; do
    name=${item##*/}
    if [[ -d $item ]]; then
      ensure_directory "$relative$name"
      copy_tree "$item" "$relative$name/"
    elif [[ $relative$name == .gitconfig ]]; then
      install_git_config "$item"
    else
      copy_file "$item" "$relative$name"
    fi
  done
}

run_script() {
  local script=$1 workspace status
  [[ -f $script ]] || fail "Not a script: $script"
  workspace=$(mktemp -d "$WORK_DIR/script.XXXXXX")
  printf 'Running: %s\n' "$script"
  # A separate Bash process preserves errexit even in this conditional.
  if (cd "$workspace" && bash -euo pipefail "$script"); then
    printf 'Completed: %s\n' "$script"
    return 0
  else
    status=$?
    printf 'Failed (%s): %s\nWorkspace retained: %s\n' "$status" "$script" "$WORK_DIR" >&2
    exit "$status"
  fi
}

run_phase() {
  local phase=$1 profile script
  printf '\n[%s] Running scripts for: %s\n' "$phase" "${PROFILES[*]}"
  for profile in "${PROFILES[@]}"; do
    for script in "$PROFILE_DIR/$profile/$phase"/*.sh; do
      run_script "$script"
    done
  done
}

stage_home() {
  local profile
  printf '\n[Home] Installing configuration for: %s\nHome directory: %s\n' "${PROFILES[*]}" "$HOME"
  mkdir -p "$WORK_DIR/home"
  for profile in "${PROFILES[@]}"; do
    if [[ -d $PROFILE_DIR/$profile/home ]]; then
      cp -R "$PROFILE_DIR/$profile/home/." "$WORK_DIR/home/"
    fi
  done
  if [[ -f $WORK_DIR/home/.config/nvim/init.lua ]]; then
    ensure_directory .config/nvim
    backup "$HOME/.config/nvim/init.vim" .config/nvim/init.vim
  fi
  # Retire the old activation helper so copied installations cannot keep using it.
  if [[ -f $WORK_DIR/home/.bashrc ]]; then
    ensure_directory .source
    backup "$HOME/.source/enable.sh" .source/enable.sh
  fi
  copy_tree "$WORK_DIR/home"
}

command=${1:---help}
[[ $# == 0 ]] || shift
case $command in
  -h|--help|help) usage; exit 0 ;;
  info) uname -a; exit 0 ;;
  ls|list) show_profiles; exit 0 ;;
  script)
    [[ $# == 1 && -f $1 ]] || fail 'Usage: ./setup script SCRIPT_PATH'
    script=$(cd "$(dirname "$1")" && pwd)/$(basename "$1") ;;
  install|home|pre|init|post|plan)
    [[ $# -gt 0 ]] || fail 'Specify at least one profile; use ./setup ls to list them.'
    PROFILES=()
    for profile in "$@"; do
      case $profile in
        OSX) printf 'OSX is now macOS; using macOS.\n' >&2; profile=macOS ;;
        MacDesktop) printf 'MacDesktop is now Hammerspoon; using Hammerspoon.\n' >&2; profile=Hammerspoon ;;
        BuildTools|DotNet|Tilix) fail "$profile has been removed; use ./setup ls to see available profiles." ;;
      esac
      [[ $profile != *[!a-zA-Z0-9_-]* && -d $PROFILE_DIR/$profile ]] || fail "Unsupported profile: $profile"
      [[ $profile != Windows ]] || fail 'Use setup.ps1 for Windows.'
      PROFILES+=("$profile")
    done ;;
  *) usage >&2; exit 1 ;;
esac

if [[ $command == plan ]]; then
  printf 'Setup preview (no changes will be made)\nHome directory: %s\nBackup directory: %s\n\n' "$HOME" "$HOME/.profile-backups"
  for profile in "${PROFILES[@]}"; do
    show_profile "$PROFILE_DIR/$profile"
  done
  printf 'Install order: pre -> home -> init -> post; later profiles override matching home files.\n'
  exit 0
fi

WORK_DIR=$(mktemp -d "${TMPDIR:-/tmp}/profile-setup.XXXXXX")
case $command in
  install) run_phase pre; stage_home; run_phase init; run_phase post ;;
  home) stage_home ;;
  pre|init|post) run_phase "$command" ;;
  script) run_script "$script" ;;
esac
rm -rf -- "$WORK_DIR"
printf '\nSetup completed.\n'
if [[ $command == install || $command == home ]]; then
  printf 'Configuration files copied: %s; unchanged: %s; entries backed up: %s\n' "$COPIED_COUNT" "$UNCHANGED_COUNT" "$BACKUP_COUNT"
  if [[ -n $BACKUP_DIR ]]; then printf 'Recover previous settings from: %s\n' "$BACKUP_DIR"; fi
  printf 'Open a new Bash session to load updated tools and profile settings.\n'
fi
